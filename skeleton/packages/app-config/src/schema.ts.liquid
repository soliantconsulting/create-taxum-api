import { z } from "zod";

export const appConfigSchema = z.object({
    {%- if features contains "oauth2" %}
    jwt: z.object({
        issuer: z.string(),
        jwksUri: z.url(),
        {%- if oauthProvider == "cognito" %}
        clientIds: z.array(z.string()).min(1),
        {%- else %}
        audience: z.string(),
        {%- endif %}
    }),
    {%- endif %}
});

export type AppConfig = z.output<typeof appConfigSchema>;
