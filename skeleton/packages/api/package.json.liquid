{
    "name": "@{{project.name}}/api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "devDependencies": {
        "@taxum/testing": "^1.0.0",
        "@tsconfig/node26": "^26.0.0",
        "@types/node": "^26.1.2"
        {%- if features contains "postgres" %},
        "@mikro-orm/cli": "^7.1.3",
        "@types/pg": "^8.20.0",
        "pg": "^8.22.0",
        "sql-formatter": "^15.8.0"
        {%- endif %}
    },
    "dependencies": {
        {%- if features contains "app-config" %}
        "@{{project.name}}/app-config": "workspace:*",
        {%- endif %}
        {%- if sentry %}
        "@sentry/node": "^10.68.0",
        {%- endif %}
        "dotenv": "^17.4.2",
        "logforth": "^1.3.0",
        "zod": "^4.4.3",
        "@jsonapi-serde/integration-taxum": "^1.4.3",
        "@jsonapi-serde/server": "^1.9.1",
        "@taxum/core": "^1.3.0"
        {%- if features contains "postgres" %},
        "@aws-sdk/client-secrets-manager": "^3.1061.0",
        "@mikro-orm/core": "^7.1.3",
        "@mikro-orm/decorators": "^7.1.3",
        "@mikro-orm/postgresql": "^7.1.3",
        "@mikro-orm/migrations": "^7.1.3",
        "@sindresorhus/fnv1a": "^3.1.0"
        {%- endif %}
        {%- if features contains "oauth2" %},
        "@taxum/jwt": "^1.1.5",
        "jose": "^6.2.3"
        {%- endif %}
    },
    "scripts": {
        "start": "tsx watch -C development{% if sentry %} --import=./src/instrument.ts{% endif %} --import=./src/register-crash-logger.ts ./src/index.ts",
        "test": "mkdir -p test-results && tsx -C development --test{% if features contains "postgres" %} --test-global-setup=./test/setup/global-setup.mjs --import=./test/setup/worker-db.ts{% endif %} --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/junit.xml 'test/**/*.test.ts'",
        "typecheck": "tsc --noEmit",
        "build": "tsc -p tsconfig.build.json"
        {%- if features contains "postgres" %},
        "mikro-orm": "tsx -C development ./node_modules/@mikro-orm/cli/cli"
        {%- endif %}
    }
    {%- if features contains "postgres" %},
    "mikro-orm": {
        "configPaths": ["./src/mikro-orm.config.ts", "./mikro-orm.config.js"]
    }
    {%- endif %}
}
