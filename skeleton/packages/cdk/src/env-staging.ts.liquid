import { App } from "aws-cdk-lib";
import { ApiStack } from "./api-stack.js";

const app = new App();

new ApiStack(app, "{{project.name}}-staging", {
    env: {
        account: "{{awsEnv.accountId}}",
        region: "{{awsEnv.region}}",
    },
    apiEnv: "staging",
    certificateArn: "{{stagingDomain.certificateArn}}",
    {%- if oauthProvider == "cognito" %}
    // Lets the API manage users in the pool; see "Authentication (AWS Cognito)" in the README.
    // userPoolArn: "<CognitoUserPoolArn output of the React app's stack>",
    {%- endif %}
    {%- if sentry %}
    sentryDsn: "{{sentry.dsn}}",
    {%- endif %}
});

app.synth();
