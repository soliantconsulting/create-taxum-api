image: public.ecr.aws/docker/library/node:26

definitions:
  caches:
    pnpm: $BITBUCKET_CLONE_DIR/.pnpm-store
  {%- if features contains "postgres" %}
  services:
    postgres:
      image: public.ecr.aws/docker/library/postgres:16-alpine
      environment:
        PGPORT: '3002'
        POSTGRES_PASSWORD: dev
        POSTGRES_USER: dev
        POSTGRES_DB: dev
  {%- endif %}
  steps:
    - step: &check
        name: Check
        runs-on:
          - 'self.hosted'
          - 'linux'
        script:
          - npm install -g corepack@latest
          - corepack enable
          - pnpm install
          - bash ci-check.sh
        caches:
          - pnpm
        {%- if features contains "postgres" %}
        services:
          - postgres
        {%- endif %}
    - step: &deploy
        runs-on:
          - 'self.hosted'
          - 'linux'
        oidc: true
        services:
          - docker
        caches:
          - pnpm
          - docker
        script:
          # Configure OIDC
          - export AWS_REGION={{awsEnv.region}}
          - export AWS_ROLE_ARN={{deployRole.arn}}
          - export AWS_WEB_IDENTITY_TOKEN_FILE=$(pwd)/web-identity-token
          - echo $BITBUCKET_STEP_OIDC_TOKEN > $(pwd)/web-identity-token
          # Install dependencies
          - npm install -g corepack@latest
          - corepack enable
          - pnpm install
          # Deploy with CDK
          - cd packages/cdk
          - pnpm build
          - pnpm exec cdk deploy --app dist/env-$BITBUCKET_DEPLOYMENT_ENVIRONMENT.js --require-approval never

pipelines:
  branches:
    main:
      - step: *check
      - step:
          <<: *deploy
          name: Deploy Staging
          deployment: staging
      - step:
          <<: *deploy
          name: Deploy Production
          deployment: production
          trigger: manual
  pull-requests:
    '**':
      - step: *check
